# systemd unit for speed-test-rs (SPEC §10.1).
#
# Install:
#   sudo install -m 0755 speed-test-rs /usr/local/bin/speed-test-rs
#   sudo install -m 0644 contrib/speed-test-rs.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now speed-test-rs
#
# Change settings without editing this file:
#   sudo systemctl edit speed-test-rs
#   [Service]
#   Environment=SPEEDTEST_LISTEN=0.0.0.0:9000
#   Environment=SPEEDTEST_SERVER_NAME=nas
#
# History lives in /var/lib/speed-test-rs (StateDirectory, owned by the dynamic user).
# Logs: journalctl -u speed-test-rs -f

[Unit]
Description=speed-test-rs LAN speed test server
Documentation=https://github.com/puttyman/speed-test-rs
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/speed-test-rs
Restart=on-failure
RestartSec=2s

# Runs as a throwaway system user allocated at start; no account to create.
DynamicUser=yes
StateDirectory=speed-test-rs
StateDirectoryMode=0750
Environment=SPEEDTEST_DATA_DIR=%S/speed-test-rs
Environment=SPEEDTEST_LISTEN=0.0.0.0:8080
Environment=SPEEDTEST_UDP_PORT=3478
Environment=RUST_LOG=info
# Optional secrets (SPEEDTEST_AUTH_TOKEN=...) go in a root-only file:
EnvironmentFile=-/etc/speed-test-rs.env

# Throughput tests open many sockets.
LimitNOFILE=65536

# The default ports are unprivileged. To listen on a port below 1024, uncomment:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening (check with: systemd-analyze security speed-test-rs)
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
